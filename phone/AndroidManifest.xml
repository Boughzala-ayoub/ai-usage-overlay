<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android" package="com.local.aiusage">
  <uses-permission android:name="android.permission.INTERNET" />
  <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
  <application android:label="AI Usage" android:icon="@drawable/icon" android:theme="@android:style/Theme.DeviceDefault">
    <activity android:name=".Main" android:exported="true">
      <intent-filter>
        <action android:name="android.intent.action.MAIN" />
        <category android:name="android.intent.category.LAUNCHER" />
      </intent-filter>
    </activity>
    <service android:name=".Bubble" android:exported="false" android:foregroundServiceType="specialUse">
      <property android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE" android:value="A floating bubble showing AI usage limits" />
    </service>
    <!-- Takes the screenshot a snip is cut from; only the system can bind it. -->
    <service android:name=".Snipper" android:exported="true" android:label="AI Usage snipping" android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
      <intent-filter>
        <action android:name="android.accessibilityservice.AccessibilityService" />
      </intent-filter>
      <meta-data android:name="android.accessibilityservice" android:resource="@xml/snipper" />
    </service>
    <provider android:name=".Snips" android:authorities="com.local.aiusage.snips" android:exported="false" android:grantUriPermissions="true" />
  </application>
</manifest>
